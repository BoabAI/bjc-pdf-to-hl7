# Auth.js v5 / Microsoft Entra ID SSO
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=replace_with_32_byte_hex
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AZURE_AD_CLIENT_ID=replace_with_app_id
AZURE_AD_CLIENT_SECRET=replace_with_client_secret
# Use "common" for multi-tenant; or a specific tenant id to lock to one tenant
AZURE_AD_TENANT_ID=common
# Comma-separated UPN domains allowed to sign in (case-insensitive)
AUTH_ALLOWED_DOMAINS=bjchealth.com.au,smecai.au
# Comma-separated Entra tenant IDs (tid claim) allowed to sign in. Required:
# with AZURE_AD_TENANT_ID=common the issuer cannot pin a tenant. Empty = deny all.
# bjchealth.com.au tenant, then smecai.au (Boab AI) tenant.
AUTH_ALLOWED_TENANT_IDS=6ecdd65f-c3dd-4d09-839a-c2357564832a,197609ee-9f62-4b85-b8b0-d3e2b6c1d4b4

# OpenRouter API (for vision LLM extraction of image-based PDFs)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: override the default model (google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash

# PAD email pipeline shared bearer token. Required for any service-to-service
# call to /api/convert with `X-Source: email`. Generate with:
#   openssl rand -hex 32
# Minimum 16 chars; rotate quarterly. Both ends (this app + the PAD pipeline)
# must hold the same value.
PAD_TOKEN=replace_with_32_byte_hex
