# Auth.js v5 / Microsoft Entra ID SSO
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=replace_with_32_byte_hex
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AZURE_AD_CLIENT_ID=replace_with_app_id
AZURE_AD_CLIENT_SECRET=replace_with_client_secret
# Use "common" for multi-tenant; or a specific tenant id to lock to one tenant
AZURE_AD_TENANT_ID=common
# Comma-separated UPN domains allowed to sign in (case-insensitive)
AUTH_ALLOWED_DOMAINS=bjchealth.com.au,smecai.au

# OpenRouter API (for vision LLM extraction of image-based PDFs)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: override the default model (google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
