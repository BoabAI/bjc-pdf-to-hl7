# AWS Amplify Ignore File
# Files and directories that should not be deployed

# Git
.git
.gitignore

# Dependencies (Amplify installs during build)
node_modules

# IDE
.idea
.vscode
*.swp
*.swo

# Documentation
*.md
!README.md

# Docs directory (test PDFs, plans, business docs — not needed at runtime)
docs/

# Local environment files
.env
.env.local
.env.development
.env.production
.env*.local

# Infrastructure as code (Terraform config, local state, tfvars secrets)
infra/

# Local Claude Code state
.claude/

# Supabase migrations (legacy, not used at runtime)
supabase/

# Local-only sample and output directories
/samples/
/output/

# Test files
**/*.test.ts
**/*.spec.ts
**/*.test.pdf
__tests__/
/coverage

# Scripts (dev tools, not needed in build)
/scripts/

# Playwright MCP debug artifacts
.playwright-mcp/

# Local UI test screenshots
/login-mobile.png
/login-with-video.png
/conversion-options-after.png

# Local artifacts
*.zip
*.hl7

# Misc
.DS_Store
Thumbs.db
.nano-banana-config.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Python scripts
*.py

# bun.lock is needed by Amplify's bun install --frozen-lockfile
# (only the legacy binary lockfile is excluded)
bun.lockb
